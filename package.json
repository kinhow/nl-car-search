{
  "name": "nl-car-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:generate": "tsx scripts/generate-listings.ts",
    "data:embed": "tsx --env-file=.env.local scripts/embed.ts",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "eval:parse": "tsx --env-file-if-exists=.env.local evals/run.ts parse",
    "eval:retrieval": "tsx --env-file-if-exists=.env.local evals/run.ts retrieval",
    "eval:ask": "tsx --env-file-if-exists=.env.local evals/run.ts ask"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
